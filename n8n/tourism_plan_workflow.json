    {
      "parameters": {
        "jsCode": "// Step 02: Validate required fields and normalize user inputs\nconst body = $input.item.json.body || $input.item.json;\n\nconst query = body.query || body.user_query || '';\nconst deadline = body.deadline || body.return_deadline || '18:00';\nconst startTime = body.start_time || '10:00';\nconst durationHours = parseFloat(body.duration_hours || body.time_budget_hours) || 6.0;\nconst city = body.city || 'Gwalior';\nconst category = body.category || 'all';\n\nif (!query || query.trim().length === 0) {\n  return [{\n    json: {\n      isValid: false,\n      error: 'VALIDATION_FAILED: Natural-language query is required',\n      statusCode: 400\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    payload: {\n      user_query: query,\n      deadline: deadline,\n      start_time: startTime,\n      duration_hours: durationHours,\n      city: city,\n      category: category,\n      origin: body.origin || { lat: 26.2298, lng: 78.1733, label: 'Fort Main Gate' },\n      companion: body.companion || 'solo',\n      transit_mode: body.transit_mode || 'auto'\n    }\n  }\n}];"
      },
      "id": "validate-inputs-02",
      "name": "2. Validate Inputs & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-valid-03",
      "name": "3. Valid Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/plan",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "http-langgraph-04",
      "name": "4. LangGraph API (POST /plan)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format LangGraph Response with Audit Trail & Timestamp\nconst raw = $input.item.json;\nreturn [{\n  json: {\n    orchestrator: 'n8n Workflow Automation Engine',\n    timestamp: new Date().toISOString(),\n    status: raw.status || 'feasible',\n    deadline: raw.deadline,\n    trip_summary: raw.trip_summary,\n    itinerary: raw.itinerary || [],\n    evidence: raw.evidence || [],\n    rejected_options: raw.rejected_options || [],\n    warnings: raw.warnings || [],\n    agent_trace: raw.agent_trace || []\n  }\n}];"
      },
      "id": "format-response-05",
