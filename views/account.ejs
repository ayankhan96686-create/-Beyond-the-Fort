<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/auth.css"></head><body class="heritage-app subpage" data-user-id="<%= currentUser.id %>"><%- include('partials/navbar') %><main class="auth-shell"><section class="auth-card"><p class="auth-kicker" data-i18n="auth.account">YOUR ACCOUNT</p><h1 data-i18n="auth.accountTitle">Account details</h1><form id="profileForm"><label><span data-i18n="auth.email">Email address</span><input name="email" type="email" maxlength="254" required></label><p id="profileMessage" class="auth-message" role="status"></p><button class="auth-submit" type="submit" data-i18n="auth.updateEmail">Update email</button></form><button class="auth-submit auth-logout" id="logoutButton" type="button" data-i18n="auth.signOut">Sign out</button><p class="auth-hint" data-i18n="auth.roleNote">Your role is assigned by an administrator and cannot be changed here.</p></section><section class="auth-card saved-plans"><p class="auth-kicker" data-i18n="auth.plans">YOUR PLANS</p><h2 data-i18n="auth.savedPlans">Saved itineraries</h2><div id="savedItineraries" aria-live="polite">Loading your saved plans…</div></section></main><script src="/js/i18n.js" defer></script><script src="/js/main.js" defer></script><script src="/js/auth.js" defer></script></body></html>
