<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <meta name="theme-color" content="#350d0e">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="heritage-app subpage">
  <%- include('partials/navbar') %>
  <main class="auth-shell">
    <section class="auth-card" aria-labelledby="auth-heading">
      <p class="auth-kicker">BEYOND THE FORT · GWALIOR</p>
      <h1 id="auth-heading">Forgot Password</h1>
      <p class="auth-intro">Enter your account email address below. If an account exists, we will send you a secure link to reset your password.</p>
      
      <form id="forgotForm" novalidate>
        <label>
          <span>Email address</span>
          <input name="email" id="forgotEmail" type="email" autocomplete="email" maxlength="254" placeholder="name@example.com" required autofocus>
        </label>
        
        <p id="forgotMessage" class="auth-message" role="status" aria-live="polite"></p>
        
        <button class="auth-submit" id="forgotSubmit" type="submit">Send Reset Link</button>
      </form>
      
      <p class="auth-switch">
        <span>Remember your password?</span>
        <a href="/login">Back to Sign in</a>
      </p>
      
      <p class="auth-hint">
        Reset links expire after 60 minutes. If you do not see an email, check your spam folder or verify your registered email address.
      </p>
    </section>
  </main>
  
  <script src="/js/i18n.js" defer></script>
  <script src="/js/main.js" defer></script>
  <script src="/js/auth.js" defer></script>
</body>
</html>
