<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><meta name="theme-color" content="#350d0e"><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/auth.css"></head>
<body class="heritage-app subpage"><%- include('partials/navbar') %><main class="auth-shell"><section class="auth-card" aria-labelledby="auth-heading"><p class="auth-kicker" data-i18n="auth.brand">BEYOND THE FORT · GWALIOR</p><h1 id="auth-heading" data-i18n="<%= mode === 'register' ? 'auth.registerTitle' : 'auth.loginTitle' %>"><%= mode === 'register' ? 'Create your account' : 'Welcome back' %></h1><p class="auth-intro" data-i18n="<%= mode === 'register' ? 'auth.registerIntro' : 'auth.loginIntro' %>"><%= mode === 'register' ? 'Save your visits and plan a day that fits.' : 'Sign in to plan and manage your visits.' %></p><form id="authForm" data-mode="<%= mode %>" novalidate><label><span data-i18n="auth.email">Email address</span><input name="email" type="email" autocomplete="email" maxlength="254" required></label><label><span data-i18n="auth.password">Password</span><input name="password" type="password" autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" minlength="12" maxlength="128" required></label><% if (mode === 'register') { %><p class="auth-hint" data-i18n="auth.passwordHint">Use at least 12 characters with an uppercase letter, lowercase letter, and number.</p><% } %><p id="authMessage" class="auth-message" role="status" aria-live="polite"></p><button class="auth-submit" type="submit" data-i18n="<%= mode === 'register' ? 'auth.registerButton' : 'auth.loginButton' %>"><%= mode === 'register' ? 'Create account' : 'Sign in' %></button></form><p class="auth-switch"><span data-i18n="<%= mode === 'register' ? 'auth.haveAccount' : 'auth.newAccount' %>"><%= mode === 'register' ? 'Already have an account?' : 'New to Beyond the Fort?' %></span> <a href="<%= mode === 'register' ? '/login' : '/register' %>" data-i18n="<%= mode === 'register' ? 'auth.loginButton' : 'auth.registerButton' %>"><%= mode === 'register' ? 'Sign in' : 'Create an account' %></a></p><% if (mode === 'login') { %><p class="auth-hint"><a href="/forgot-password" style="color:#702220;font-weight:600;">Forgot your password?</a></p><% } %></section></main><script src="/js/i18n.js" defer></script><script src="/js/main.js" defer></script><script src="/js/auth.js" defer></script></body></html>
