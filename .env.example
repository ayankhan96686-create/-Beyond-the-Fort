# Node / Express
PORT=3000
HOST=127.0.0.1
LANGGRAPH_API_URL=http://127.0.0.1:8000/plan
LANGGRAPH_SERVICE_TOKEN=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INITIAL_ADMIN_EMAIL=
AUTH_USERS_FILE=
SAVED_ITINERARIES_FILE=
TRUST_PROXY_HOPS=0

# Flask / LangGraph (set in the Python service environment)
LANGGRAPH_PORT=8000

# Mapbox: ROUTING_PROVIDER_URL=https://api.mapbox.com and ROUTING_PROVIDER_API_KEY=<access token>
# Other providers may use POST {origin,destination,mode} -> {distance_km,duration_minutes,provider,retrieved_at}
ROUTING_PROVIDER_URL=
ROUTING_PROVIDER_API_KEY=
ROUTING_PROVIDER_TIMEOUT_SECONDS=5

# Explicit test/demo only. Default false; without a provider the workflow returns provider_error.
DEMO_MODE=false

# Existing separate intent/feasibility endpoints may use these optional services.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=60000
DISTANCE_MATRIX_API_KEY=
MONGODB_URI=
TRANSIT_API_TIMEOUT_MS=3000
SAFETY_BUFFER_RATIO=0.25
